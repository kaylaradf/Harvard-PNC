<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       page-range-format="expanded" page-range-delimiter="-"
       class="in-text"
       default-locale="en-GB">
  <info>
    <title>Harvard - Format Kampus (Custom)</title>
    <title-short>Harvard Kampus Custom</title-short>
    <id>http://www.zotero.org/styles/harvard-kampus-custom</id>
    <link href="http://www.zotero.org/styles/harvard-kampus-custom" rel="self"/>
    <updated>2026-09-28T01:00:00+00:00</updated>
    <summary>Custom Harvard author-date style based exactly on the supplied bibliography example.</summary>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</rights>
  </info>

  <locale xml:lang="en-GB">
    <terms>
      <term name="and">and</term>
      <term name="page" form="short">p.</term>
      <term name="page" form="short" plural="true">pp.</term>
    </terms>
  </locale>

  <!-- Author list: Family, Initials., Family, Initials. & Family, Initials. -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with="."
            delimiter=", "
            delimiter-precedes-last="never"
            and="symbol"
            delimiter-precedes-et-al="never"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all"
                sort-separator=", "
                initialize-with="."
                delimiter=", "
                delimiter-precedes-last="never"
                and="symbol"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <!-- In-text author form -->
  <macro name="author-short">
    <names variable="author">
      <name form="short"
            and="symbol"
            delimiter=", "
            delimiter-precedes-last="never"/>
      <et-al font-style="normal"/>
      <substitute>
        <names variable="editor">
          <name form="short" and="symbol" delimiter=", " delimiter-precedes-last="never"/>
        </names>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="article-title">
    <text variable="title" prefix="'" suffix="'"/>
  </macro>

  <macro name="journal-details">
    <group delimiter=", ">
      <text variable="container-title"/>
      <group delimiter="">
        <text variable="volume"/>
        <text variable="issue" prefix="(" suffix=")"/>
      </group>
      <text variable="page" prefix="pp. "/>
    </group>
  </macro>

  <citation disambiguate-add-year-suffix="true">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="year"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true">
    <sort>
      <key macro="author"/>
      <key macro="year"/>
      <key variable="title"/>
    </sort>

    <layout suffix=".">
      <choose>
        <!-- Journal article: exactly follows the supplied example -->
        <if type="article-journal" match="any">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <group delimiter=", ">
              <text macro="article-title"/>
              <group delimiter=", ">
                <text variable="container-title"/>
                <group delimiter="">
                  <text variable="volume"/>
                  <text variable="issue" prefix="(" suffix=")"/>
                </group>
                <text variable="page" prefix="pp. "/>
              </group>
            </group>
          </group>
        </if>

        <!-- Book -->
        <else-if type="book" match="any">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <text variable="title" font-style="italic"/>
            <group delimiter=", ">
              <text variable="edition" suffix=" ed."/>
              <group delimiter=": ">
                <text variable="publisher-place"/>
                <text variable="publisher"/>
              </group>
            </group>
          </group>
        </else-if>

        <!-- Chapter -->
        <else-if type="chapter" match="any">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <text macro="article-title"/>
            <group delimiter=", ">
              <group delimiter=" ">
                <text term="in" text-case="lowercase"/>
                <text variable="container-title" font-style="italic"/>
              </group>
              <text variable="page" prefix="pp. "/>
              <group delimiter=": ">
                <text variable="publisher-place"/>
                <text variable="publisher"/>
              </group>
            </group>
          </group>
        </else-if>

        <!-- Thesis / dissertation -->
        <else-if type="thesis" match="any">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <text variable="title" font-style="italic"/>
            <text variable="genre" prefix=", "/>
            <group delimiter=": ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
          </group>
        </else-if>

        <!-- Web page -->
        <else-if type="webpage" match="any">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <text variable="title" prefix="'" suffix="'"/>
            <text variable="container-title" prefix=", " font-style="italic"/>
            <text variable="URL" prefix=", "/>
            <group prefix=" (accessed " suffix=")" delimiter=" ">
              <date variable="accessed">
                <date-part name="day"/>
                <date-part name="month"/>
                <date-part name="year"/>
              </date>
            </group>
          </group>
        </else-if>

        <!-- Generic fallback -->
        <else>
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <text variable="title" prefix="'" suffix="'"/>
            <text variable="container-title" prefix=", "/>
            <text variable="page" prefix=", pp. "/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
