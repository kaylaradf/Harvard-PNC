<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-GB">
  <info>
    <title>Harvard Kampus Custom (Mendeley Safe)</title>
    <title-short>Harvard Kampus</title-short>
    <id>http://www.zotero.org/styles/harvard-kampus-custom-mendeley-safe</id>
    <link href="http://www.zotero.org/styles/harvard-kampus-custom-mendeley-safe" rel="self"/>
    <updated>2026-09-28T12:00:00+07:00</updated>
    <category citation-format="author-date"/>
    <summary>Custom Harvard author-date bibliography matching the supplied campus example, written using conservative CSL 1.0 constructs for Mendeley compatibility.</summary>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</rights>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with="."
            delimiter=", "
            delimiter-precedes-last="never"
            and="symbol"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all"
                sort-separator=", "
                initialize-with="."
                delimiter=", "
                delimiter-precedes-last="never"
                and="symbol"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-short">
    <names variable="author">
      <name form="short" and="symbol" delimiter=", " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor">
          <name form="short" and="symbol" delimiter=", " delimiter-precedes-last="never"/>
        </names>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="article-title">
    <text variable="title" prefix="'" suffix="'"/>
  </macro>

  <macro name="page">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>

  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="year"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true">
    <sort>
      <key macro="author"/>
      <key macro="year"/>
      <key variable="title"/>
    </sort>

    <layout suffix=".">
      <choose>
        <if type="article-journal">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <group delimiter=", ">
              <text macro="article-title"/>
              <group delimiter=", ">
                <text variable="container-title"/>
                <group delimiter="">
                  <text variable="volume"/>
                  <text variable="issue" prefix="(" suffix=")"/>
                </group>
                <text macro="page"/>
              </group>
            </group>
          </group>
        </if>

        <else-if type="book">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <text variable="title" font-style="italic"/>
            <group delimiter=", ">
              <text variable="edition"/>
              <group delimiter=": ">
                <text variable="publisher-place"/>
                <text variable="publisher"/>
              </group>
            </group>
          </group>
        </else-if>

        <else-if type="chapter">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <text macro="article-title"/>
            <group delimiter=", ">
              <text variable="container-title" font-style="italic" prefix="In "/>
              <text macro="page"/>
              <group delimiter=": ">
                <text variable="publisher-place"/>
                <text variable="publisher"/>
              </group>
            </group>
          </group>
        </else-if>

        <else-if type="thesis">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <text variable="title" font-style="italic"/>
            <text variable="genre" prefix=", "/>
            <group delimiter=": ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
          </group>
        </else-if>

        <else-if type="webpage">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <text variable="title" prefix="'" suffix="'"/>
            <text variable="container-title" prefix=", "/>
            <text variable="URL" prefix=", "/>
          </group>
        </else-if>

        <else>
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="year" prefix="(" suffix=")"/>
            <text variable="title" prefix="'" suffix="'"/>
            <text variable="container-title" prefix=", "/>
            <text macro="page" prefix=", "/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
